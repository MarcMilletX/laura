# ============================================================
#  CLAVES DE LAURA
# ============================================================
#  Este archivo es donde van tus claves. Viene vacío a propósito.
#
#  1. Ábrelo con un editor de texto (TextEdit en Mac, Bloc de
#     notas en Windows).
#  2. Pega cada dato justo después del signo =, sin comillas ni
#     espacios.
#  3. Guárdalo y, en LAURA, pulsa «Cargar claves» y elige este
#     archivo.
#
#  Tus claves son privadas: no compartas este archivo una vez
#  relleno ni lo subas a internet.
# ============================================================

# Código de tu voz en Cartesia
# Dónde: play.cartesia.ai > Voice Library > My voices > ⋮ > Copy ID
# Ejemplo: CARTESIA_VOICE_ID=3f9c2a71-5b8e-4d20-9c1a-7e6b2d4f8a05
CARTESIA_VOICE_ID=

# Clave de la API de Cartesia
# Dónde: play.cartesia.ai > API Keys > crear una clave nueva
# Empieza por sk_car_
CARTESIA_API_KEY=

# Opcional: clave gratuita de Google, solo para el modo «Lo que yo le diga»
# Dónde: aistudio.google.com/apikey > Create API key
GEMINI_API_KEY=
